# Copy this file to .env and change the secrets before running anywhere real.

# Flask
FLASK_DEBUG=false

# MongoDB (docker compose overrides MONGO_URI to point at the mongo container)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=triad_dms

# Auth. Use a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=480
# bcrypt cost factor; each +1 doubles hashing time
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=6

# Uploads
MAX_UPLOAD_MB=25
# Only for the evaluators' test script, which uploads without a token. Set to false in production.
ALLOW_ANONYMOUS_UPLOAD=true

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Super admin, created by the seed if it doesn't exist yet
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DIVISION=Headquarters

# Login rate limit. Storage defaults to MONGO_URI so all workers share counts.
LOGIN_RATE_LIMIT=10 per minute
RATELIMIT_STORAGE_URI=

# OCR. Full path to tesseract if it isn't on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Max scanned pages OCR'd per upload, and seconds allowed per page
OCR_MAX_PAGES=25
OCR_PAGE_TIMEOUT=60

# Number of gunicorn workers in Docker
GUNICORN_WORKERS=3
